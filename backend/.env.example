# ── Backend — variables d'environnement ────────────────────────────────────
# Copie ce fichier en .env et remplis les valeurs. Ne jamais committer .env.

# Base de données (obligatoire)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/ifsi-db

# Authentification (obligatoire)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
PORT=5000
FRONTEND_URL=https://www.nursesprep.fr

# Emails transactionnels (vérification, reset) — optionnel
RESEND_API_KEY=

# Paiement Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# Connexion Google (OAuth) — optionnel
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notifications push (VAPID) — optionnel
VAPID_PUBLIC_KEY=

# Génération IA — optionnel
ANTHROPIC_API_KEY=

# ── Monitoring d'erreurs Sentry (optionnel) ────────────────────────────────
# Laisser vide désactive complètement Sentry (dev / preview).
# Renseigner le DSN en production pour capturer les erreurs.
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1

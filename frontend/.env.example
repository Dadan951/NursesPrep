# ── Frontend — variables d'environnement (CRA : préfixe REACT_APP_) ─────────
# Copie ce fichier en .env et remplis les valeurs. Ne jamais committer .env.

# URL de l'API backend (par défaut : https://api.nursesprep.fr/api)
REACT_APP_API_URL=

# ── Monitoring d'erreurs Sentry (optionnel) ────────────────────────────────
# Laisser vide désactive Sentry. Renseigner le DSN "frontend" en production.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_TRACES_RATE=0.1
